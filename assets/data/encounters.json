{
    "encounters": [
        {
            "id": "EVENT_WEEPING_STATUE",
            "title": "The Weeping Statue",
            "imagePath": "images/events/statue_cry.png",
            "text": "You find a moss-covered statue of a knight. Tears of blood stream from its stone eyes, pooling in a basin below.",
            "choices": [
                {
                    "text": "Drink from the basin.",
                    "type": "RISK_REWARD",
                    "successChance": 0.5,
                    "successEffect": {
                        "type": "HEAL",
                        "amount": 10,
                        "text": "The metallic taste invigorates you."
                    },
                    "failEffect": {
                        "type": "POISON",
                        "amount": 5,
                        "text": "The blood burns your throat. It is cursed!"
                    }
                },
                {
                    "text": "Inspect the statue (Requires: PERCEPTION > 10)",
                    "requirement": {
                        "stat": "PERCEPTION",
                        "value": 10
                    },
                    "successEffect": {
                        "type": "GIVE_ITEM",
                        "itemId": "RING_GOLD",
                        "text": "You notice a gleaming ring hidden in the basin stones."
                    }
                },
                {
                    "text": "Leave it alone.",
                    "type": "LEAVE"
                }
            ]
        },
        {
            "id": "EVENT_BROKEN_MIRROR",
            "title": "The Broken Mirror",
            "imagePath": "images/events/broken_mirror.png",
            "text": "You gaze into the mirror. The reflection moves on its own, offering you a trade.",
