                        "text": "The reflection shatters and steps out!"
                    }
                },
                {
                    "text": "Offer your vitality (Lose 5 Max HP).",
                    "type": "TRADE",
                    "cost": {
                        "type": "MAX_HP",
                        "amount": 5
