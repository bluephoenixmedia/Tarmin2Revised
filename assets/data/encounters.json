                    "successEffect": {
                        "type": "GIVE_ITEM",
                        "itemId": "SCROLL",
                        "text": "The mirror spits out an ancient scroll."
                    }
                },
                {
                    "text": "Stare deeply (Requires: SPI > 15).",
                    "requirement": {
                        "stat": "SPIRITUAL_STRENGTH",
                        "value": 15
