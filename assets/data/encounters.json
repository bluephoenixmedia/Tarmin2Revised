                    "successEffect": {
                        "type": "GIVE_XP",
                        "amount": 500,
                        "text": "You understand the nature of the void."
                    }
                },
                {
                    "text": "Walk away.",
                    "type": "LEAVE"
                }
            ]
        },
        {
